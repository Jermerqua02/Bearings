{
  "name": "northstar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:migrate": "node scripts/migrate.mjs && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "test:boundary": "tsx scripts/test-boundary.ts",
    "test:legal": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-legal.ts",
    "test:onboarding": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-onboarding.ts",
    "test:admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-admin.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "admin:password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@better-auth/drizzle-adapter": "1.6.25",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "^15.3.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
