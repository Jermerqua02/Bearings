# ————————————————————————————————————————
# Copy to .env.local and fill in. Never commit .env.local.
# ————————————————————————————————————————

# Postgres connection string.
#
# Local dev uses the Docker Postgres in docker-compose.yml:
#
#     npm run db:up          # start it
#     npm run db:migrate     # apply migrations
#
# Keep dev pointed here rather than at Railway. Production holds real
# student records, and `npm run dev` is where you run half-finished
# migrations and seed scripts — those two facts should never meet. If the
# app hangs on sign-up or sign-in locally, the usual cause is that Docker
# isn't running.
DATABASE_URL="postgresql://bearings:bearings_local_dev@localhost:5433/bearings"

# To read or change production data, don't point this at Railway either:
# Railway's Postgres has no public endpoint, and its internal hostname
# (postgres.railway.internal) only resolves inside Railway's own network,
# so `railway run` fails with ENOTFOUND. Run the command inside the
# deployed container instead, where the internal hostname works:
#
#     railway ssh -s bearings-web "npx tsx scripts/grant-admin.ts you@example.com"
#
# If you genuinely need a direct connection from your machine, enable
# Settings → Networking → TCP Proxy on the Postgres service in the Railway
# dashboard, which exposes DATABASE_PUBLIC_URL.

# Better Auth. Generate a secret with:  openssl rand -base64 32
# Must differ between local and production.
BETTER_AUTH_SECRET=""

# The origin the app is served from. Better Auth validates request origins
# against it, so a wrong value here makes sign-in fail with no obvious
# cause. On Railway set it to the deployed URL, not localhost.
BETTER_AUTH_URL="http://localhost:3000"

# Claude — the counselor. Get one at console.anthropic.com.
# On Railway this goes on the WEB service, not the Postgres service, and the
# name must be exactly this (no spaces).
ANTHROPIC_API_KEY=""
